pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Layouts
import Quarry.Controls

// The review of the changes Claude proposed for the script of a query tab (H13 phase C). It covers
// the editor, which stays underneath untouched (cursor, undo history): nothing in the script changes
// until Apply, and Apply only writes text into the editor. It never runs anything.
//
// Every change is a block with its lines ("-" removed, "+" added, besides the color) and, until it
// is accepted or rejected, the label "Generated by AI" (icon and text). A block that adds DML or DDL
// says so. Keyboard on the list: Up / Down move between the changes, Enter accepts, Delete or
// Backspace rejects, Ctrl+Z undoes, Esc discards the review.
FocusScope {
    id: root

    // AiChatController of the tab.
    required property var chat
    // The text the editor holds now: when it differs from the script the proposal was made for, the
    // proposal is stale and nothing is applied.
    property string currentText: ""
    property string tabTitle: ""
    readonly property var diff: chat ? chat.diff : null
    readonly property bool stale: diff !== null && (chat.diffStale || currentText !== diff.original)
    readonly property alias list: blocks
    readonly property alias applyButton: applyBtn
    readonly property alias discardButton: discardBtn
    readonly property alias acceptAllButton: acceptAllBtn
    readonly property alias rejectAllButton: rejectAllBtn
    readonly property alias undoButton: undoBtn
    readonly property alias redoButton: redoBtn
    readonly property Item focusTarget: blocks
    // The last thing sent to the screen reader (tests read it).
    property string lastAnnouncement: ""

    signal applyRequested(string text)
    signal discardRequested
    signal announce(string text, bool assertive)

    function say(text, assertive) {
        lastAnnouncement = text;
        announce(text, assertive === true);
    }

    function proposedText(n) {
        return n === 1 ? qsTr("Claude proposed 1 change") : qsTr("Claude proposed %1 changes").arg(n);
    }

    function apply() {
        if (diff === null || stale)
            return;
        applyRequested(diff.result());
    }

    function discard() {
        discardRequested();
    }

    // Moves to the next (step 1) or previous (step -1) change.
    function move(step) {
        if (diff === null)
            return;
        const next = diff.nextChange(blocks.currentIndex, step);
        if (next >= 0) {
            blocks.currentIndex = next;
            blocks.positionViewAtIndex(next, ListView.Contain);
            say(blocks.currentItem ? blocks.currentItem.description : "");
        }
    }

    // `accepted`: the current change is accepted (true) or rejected (false).
    function decide(accepted) {
        if (diff === null || blocks.currentIndex < 0)
            return;
        const at = blocks.currentIndex;
        if (accepted)
            diff.accept(at);
        else
            diff.reject(at);
        const item = blocks.currentItem;
        say((item ? item.description + ". " : "") + qsTr("%1 pending").arg(diff.pendingCount));
        // On to the next change, as a reviewer would.
        const next = diff.nextChange(at, 1);
        if (next >= 0)
            blocks.currentIndex = next;
    }

    function decideAll(accepted) {
        if (diff === null)
            return;
        if (accepted)
            diff.acceptAll();
        else
            diff.rejectAll();
        say(accepted ? qsTr("All changes accepted") : qsTr("All changes rejected"));
    }

    function undo() {
        if (diff === null || !diff.canUndo)
            return;
        diff.undo();
        say(qsTr("Undone. %1 pending").arg(diff.pendingCount));
    }

    onDiffChanged: {
        if (diff !== null) {
            blocks.currentIndex = diff.firstChange();
            say(proposedText(diff.changeCount));
        }
    }
    Component.onCompleted: {
        if (diff !== null) {
            blocks.currentIndex = diff.firstChange();
            say(proposedText(diff.changeCount));
        }
    }

    Accessible.role: Accessible.Pane
    Accessible.name: qsTr("Review of Claude's proposal")

    Rectangle {
        anchors.fill: parent
        color: Theme.bgCanvas
    }

    ColumnLayout {
        anchors.fill: parent
        spacing: 0

        // The buttons stay in view while the blocks scroll under them.
        Flow {
            Layout.fillWidth: true
            Layout.margins: Theme.spacing * 2
            spacing: Theme.spacing

            QButton {
                id: acceptAllBtn

                text: qsTr("Accept all")
                iconGlyph: Icons.check
                enabled: root.diff !== null && !root.stale
                onClicked: root.decideAll(true)
            }

            QButton {
                id: rejectAllBtn

                text: qsTr("Reject all")
                iconGlyph: Icons.x
                enabled: root.diff !== null && !root.stale
                onClicked: root.decideAll(false)
            }

            QButton {
                id: undoBtn

                text: qsTr("Undo")
                iconGlyph: Icons.undo2
                enabled: root.diff !== null && root.diff.canUndo
                onClicked: root.undo()
            }

            QButton {
                id: redoBtn

                visible: root.stale
                text: qsTr("Redo for the current script")
                iconGlyph: Icons.refreshCw
                onClicked: root.chat.redoDiff()
            }

            QButton {
                id: applyBtn

                text: qsTr("Apply")
                variant: "primary"
                iconGlyph: Icons.fileDiff
                enabled: root.diff !== null && !root.stale
                onClicked: root.apply()

                Accessible.description: qsTr("Writes the accepted changes into the script. Changes still pending are left out. Nothing is run.")
            }

            QButton {
                id: discardBtn

                text: qsTr("Discard")
                onClicked: root.discard()

                Accessible.description: qsTr("Closes the review without changing the script")
            }
        }

        Rectangle {
            Layout.fillWidth: true
            implicitHeight: 1
            color: Theme.borderDefault
        }

        ListView {
            id: blocks

            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            model: root.diff
            header: Item {
                width: blocks.width
                implicitHeight: headerColumn.implicitHeight + Theme.spacing * 4

                // What this is, in words, and the warnings.
                ColumnLayout {
                    id: headerColumn

                    x: Theme.spacing * 2
                    y: Theme.spacing * 2
                    width: parent.width - Theme.spacing * 4
                    spacing: Theme.spacing


                    RowLayout {
                        Layout.fillWidth: true
                        spacing: Theme.spacing

                        Icon {
                            Layout.alignment: Qt.AlignTop
                            text: Icons.sparkles
                            color: Theme.accent
                        }

                        Text {
                            id: summaryText

                            Layout.fillWidth: true
                            text: root.diff ? root.proposedText(root.diff.changeCount) + ". " + qsTr("%1 pending.").arg(root.diff.pendingCount) + " " + qsTr("Nothing in your script changes until you press Apply, and Apply never runs it.") : ""
                            font.pointSize: Theme.fontSize
                            font.bold: true
                            color: Theme.fgDefault
                            wrapMode: Text.WordWrap

                            Accessible.role: Accessible.StaticText
                            Accessible.name: text
                        }
                    }

                    RowLayout {
                        id: dataWarning

                        Layout.fillWidth: true
                        visible: root.diff !== null && root.diff.modifiesData
                        spacing: Theme.spacing

                        Icon {
                            Layout.alignment: Qt.AlignTop
                            text: Icons.triangleAlert
                            color: Theme.warning
                        }

                        Text {
                            Layout.fillWidth: true
                            text: qsTr("Some changes add statements that change data or the schema. Review them before you run the script.")
                            font.pointSize: Theme.fontSize
                            color: Theme.fgDefault
                            wrapMode: Text.WordWrap

                            Accessible.role: Accessible.StaticText
                            Accessible.name: text
                        }
                    }

                    // The script was edited while Claude worked: nothing is applied blindly.
                    RowLayout {
                        id: staleWarning

                        Layout.fillWidth: true
                        visible: root.stale
                        spacing: Theme.spacing

                        Icon {
                            Layout.alignment: Qt.AlignTop
                            text: Icons.circleAlert
                            color: Theme.danger
                        }

                        Text {
                            Layout.fillWidth: true
                            text: qsTr("The script changed while Claude was working. Nothing was applied: make the proposal again for the current script, or discard it.")
                            font.pointSize: Theme.fontSize
                            color: Theme.fgDefault
                            wrapMode: Text.WordWrap

                            Accessible.role: Accessible.StaticText
                            Accessible.name: text
                        }
                    }

                    Text {
                        Layout.fillWidth: true
                        text: qsTr("Up and Down move between changes, Enter accepts, Delete rejects, %1 undoes, Esc discards.").arg(CommandRegistry.displayShortcut("Ctrl+Z"))
                        font.pointSize: Theme.fontSize * 0.9
                        color: Theme.fgMuted
                        wrapMode: Text.WordWrap
                    }

                }
            }
            focus: true
            activeFocusOnTab: true
            keyNavigationEnabled: false
            // A proposal has few blocks: all of them exist, so the screen reader finds every change.
            cacheBuffer: 100000
            boundsBehavior: Flickable.StopAtBounds
            currentIndex: -1
            spacing: 0

            Accessible.role: Accessible.List
            Accessible.name: qsTr("Proposed changes")
            Accessible.focusable: true

            Keys.onShortcutOverride: event => {
                if (event.key === Qt.Key_Z && (event.modifiers & Qt.ControlModifier))
                    event.accepted = true;
            }
            Keys.onPressed: event => {
                const ctrl = (event.modifiers & Qt.ControlModifier) !== 0;
                if (event.key === Qt.Key_Z && ctrl && !(event.modifiers & Qt.ShiftModifier)) {
                    root.undo();
                    event.accepted = true;
                } else if (event.key === Qt.Key_Backspace && !ctrl) {
                    root.decide(false);
                    event.accepted = true;
                }
            }
            Keys.onUpPressed: event => {
                root.move(-1);
                event.accepted = true;
            }
            Keys.onDownPressed: event => {
                root.move(1);
                event.accepted = true;
            }
            Keys.onReturnPressed: event => {
                root.decide(true);
                event.accepted = true;
            }
            Keys.onEnterPressed: event => {
                root.decide(true);
                event.accepted = true;
            }
            Keys.onDeletePressed: event => {
                root.decide(false);
                event.accepted = true;
            }

            delegate: Item {
                id: block

                required property int index
                required property string kind
                required property var oldLines
                required property var newLines
                required property string decision
                required property bool modifiesData
                required property int changeNumber
                required property int startLine
                required property string description
                required property int addedCount
                required property int removedCount

                readonly property bool isChange: kind !== "unchanged"
                readonly property bool current: (ListView.isCurrent ?? false) && blocks.activeFocus
                // A long stretch without changes is shown by its first and last lines.
                readonly property var plainLines: {
                    if (isChange)
                        return [];
                    const lines = oldLines;
                    if (lines.length <= 8)
                        return lines.map(t => ({
                                    "text": t,
                                    "gap": false
                                }));
                    const head = lines.slice(0, 3).map(t => ({
                                "text": t,
                                "gap": false
                            }));
                    const tail = lines.slice(lines.length - 3).map(t => ({
                                "text": t,
                                "gap": false
                            }));
                    return head.concat([
                        {
                            "text": qsTr("%1 unchanged lines").arg(lines.length - 6),
                            "gap": true
                        }
                    ], tail);
                }

                width: blocks.width
                implicitHeight: isChange ? card.implicitHeight + Theme.spacing * 2 : plain.implicitHeight + Theme.spacing

                Accessible.role: Accessible.ListItem
                Accessible.name: description
                Accessible.ignored: !isChange
                Accessible.focusable: isChange

                // The stretches of the script that do not change.
                Column {
                    id: plain

                    visible: !block.isChange
                    x: Theme.spacing * 2
                    width: parent.width - Theme.spacing * 4
                    y: Theme.spacing / 2

                    Repeater {
                        model: block.plainLines

                        Text {
                            required property var modelData

                            width: plain.width
                            text: "  " + modelData.text
                            font.family: Theme.monoFontFamily
                            font.pointSize: Theme.fontSize
                            font.italic: modelData.gap
                            textFormat: Text.PlainText
                            wrapMode: Text.WrapAnywhere
                            color: Theme.fgMuted
                            Accessible.ignored: true
                        }
                    }
                }

                // A proposed change.
                Rectangle {
                    id: cardFrame

                    visible: block.isChange
                    x: Theme.spacing
                    y: Theme.spacing
                    width: parent.width - Theme.spacing * 2
                    height: card.implicitHeight
                    color: Theme.bgSurface
                    radius: Theme.radius
                    border.width: block.current ? Theme.focusRingWidth : 1
                    border.color: block.current ? Theme.focusRing : Theme.borderStrong

                    ColumnLayout {
                        id: card

                        width: parent.width
                        spacing: Theme.spacing

                        Flow {
                            Layout.fillWidth: true
                            Layout.margins: Theme.spacing
                            spacing: Theme.spacing * 2

                            // Until it is decided, the block says where it comes from: text and icon.
                            Row {
                                visible: block.decision === "pending"
                                spacing: Theme.spacing

                                Icon {
                                    text: Icons.sparkles
                                    color: Theme.accent
                                    anchors.verticalCenter: parent.verticalCenter
                                }

                                Text {
                                    text: qsTr("Generated by AI")
                                    font.pointSize: Theme.fontSize
                                    font.bold: true
                                    color: Theme.fgDefault
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }

                            Row {
                                visible: block.decision !== "pending"
                                spacing: Theme.spacing

                                Icon {
                                    text: block.decision === "accepted" ? Icons.circleCheck : Icons.circleAlert
                                    color: block.decision === "accepted" ? Theme.success : Theme.fgMuted
                                    anchors.verticalCenter: parent.verticalCenter
                                }

                                Text {
                                    text: block.decision === "accepted" ? qsTr("Accepted") : qsTr("Rejected")
                                    font.pointSize: Theme.fontSize
                                    font.bold: true
                                    color: Theme.fgDefault
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }

                            Text {
                                text: qsTr("Change %1, line %2").arg(block.changeNumber).arg(block.startLine)
                                font.pointSize: Theme.fontSize
                                color: Theme.fgMuted
                            }

                            Row {
                                visible: block.modifiesData
                                spacing: Theme.spacing

                                Icon {
                                    text: Icons.triangleAlert
                                    color: Theme.warning
                                    anchors.verticalCenter: parent.verticalCenter
                                }

                                Text {
                                    width: Math.min(implicitWidth, cardFrame.width - Theme.spacing * 6)
                                    text: qsTr("This block changes data or the schema: review it before you run the script")
                                    font.pointSize: Theme.fontSize
                                    color: Theme.fgDefault
                                    wrapMode: Text.WordWrap
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }
                        }

                        // Removed lines ("-") and added lines ("+"): the sign says it, the tint helps.
                        Column {
                            Layout.fillWidth: true
                            Layout.leftMargin: Theme.spacing
                            Layout.rightMargin: Theme.spacing

                            Repeater {
                                model: block.oldLines

                                Rectangle {
                                    required property var modelData

                                    width: parent ? parent.width : 0
                                    height: removedText.implicitHeight
                                    color: Qt.alpha(Theme.danger, 0.14)
                                    visible: block.kind !== "added"

                                    Text {
                                        id: removedText

                                        width: parent.width
                                        text: "- " + parent.modelData
                                        font.family: Theme.monoFontFamily
                                        font.pointSize: Theme.fontSize
                                        textFormat: Text.PlainText
                                        wrapMode: Text.WrapAnywhere
                                        color: Theme.fgDefault
                                        opacity: block.decision === "accepted" ? 0.6 : 1
                                    }
                                }
                            }

                            Repeater {
                                model: block.newLines

                                Rectangle {
                                    required property var modelData

                                    width: parent ? parent.width : 0
                                    height: addedText.implicitHeight
                                    color: Qt.alpha(Theme.success, 0.14)

                                    Text {
                                        id: addedText

                                        width: parent.width
                                        text: "+ " + parent.modelData
                                        font.family: Theme.monoFontFamily
                                        font.pointSize: Theme.fontSize
                                        textFormat: Text.PlainText
                                        wrapMode: Text.WrapAnywhere
                                        color: Theme.fgDefault
                                        opacity: block.decision === "rejected" ? 0.6 : 1
                                    }
                                }
                            }
                        }

                        Flow {
                            Layout.fillWidth: true
                            Layout.margins: Theme.spacing
                            spacing: Theme.spacing

                            // The keys of the list do the same; these are for the mouse and the
                            // screen reader, so they are not tab stops of their own.
                            QButton {
                                text: qsTr("Accept")
                                iconGlyph: Icons.check
                                focusPolicy: Qt.NoFocus
                                enabled: !root.stale
                                onClicked: {
                                    blocks.currentIndex = block.index;
                                    root.decide(true);
                                }

                                Accessible.name: qsTr("Accept change %1").arg(block.changeNumber)
                            }

                            QButton {
                                text: qsTr("Reject")
                                iconGlyph: Icons.x
                                focusPolicy: Qt.NoFocus
                                enabled: !root.stale
                                onClicked: {
                                    blocks.currentIndex = block.index;
                                    root.decide(false);
                                }

                                Accessible.name: qsTr("Reject change %1").arg(block.changeNumber)
                            }
                        }
                    }
                }
            }
        }
    }

    Keys.onEscapePressed: event => {
        root.discard();
        event.accepted = true;
    }
}
